{
  "name": "openfront-env",
  "private": true,
  "type": "module",
  "description": "Headless OpenFront RL environment, bridge worker, and in-page live agent. See README.md.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "worker": "tsx src/bridge/worker_main.ts",
    "build:page": "esbuild src/live/PageAgent.ts --bundle --format=iife --platform=browser --target=es2020 --alias:resources=../OpenFrontIO/resources --outfile=dist/page_agent.js --log-level=warning"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
